# --- Service ---------------------------------------------------------------
NOM_APPLICATION=Bordereau SOCADEL
ENVIRONNEMENT=development
DEBUG=true
PREFIXE_API=/api/v1

# --- PostgreSQL ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://socadel:socadel@localhost:5432/bordereau_socadel
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Sécurité --------------------------------------------------------------
# 32 caractères minimum. À régénérer avant toute mise en production :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changez-cette-cle-en-production-32-caracteres-minimum
ALGORITHME_JWT=HS256
DUREE_SESSION_MINUTES=720

# Compte superviseur semé au premier démarrage (voir scripts/seed.py).
SUPERVISEUR_IDENTIFIANT=superviseur
SUPERVISEUR_NOM=Superviseur SOCADEL
SUPERVISEUR_MOT_DE_PASSE=Socadel@2026

# --- CORS ------------------------------------------------------------------
ORIGINES_AUTORISEES=http://localhost:3000,http://127.0.0.1:3000

# --- Import / export -------------------------------------------------------
TAILLE_MAX_IMPORT_MO=25
LIGNES_MAX_EXPORT=50000
